# Runtime
NODE_ENV=production
PORT=4310
PUBLIC_URL=https://inshinlab.com/ai-dash

# Codex-only operations: video upload/delete and manual Sheets sync
CODEX_ADMIN_TOKEN=replace-with-at-least-32-random-bytes

# Google Sheets (server-side only)
GOOGLE_SPREADSHEET_ID=YOUR_GOOGLE_SPREADSHEET_ID
# Preferred: a service-account JSON string. Share the spreadsheet with client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Safer for systemd EnvironmentFile: base64-encoded service-account JSON.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Alternative for a sheet intentionally shared for link-based read access.
GOOGLE_SHEETS_PUBLIC_READ=true
CACHE_TTL_SECONDS=900

# Private persistent video storage (outside the nginx web root)
STORAGE_DIR=/var/lib/ai-dash
MAX_UPLOAD_MB=500
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
