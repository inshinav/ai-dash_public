[Unit]
Description=AI Dash private analytics
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ai-dash
EnvironmentFile=/etc/ai-dash.env
ExecStart=/usr/bin/node /opt/ai-dash/dist-server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-dash
UMask=0077

[Install]
WantedBy=multi-user.target
